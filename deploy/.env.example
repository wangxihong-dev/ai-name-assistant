# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=请改成强密码
MYSQL_DATABASE=ai_name
MYSQL_USER=ai_name
MYSQL_PASSWORD=请改成数据库密码

# ---------- 邮箱配置（注册验证码用，需真实邮箱） ----------
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=465
MAIL_SERVER=
MAIL_FROM_NAME=AI取名助手
MAIL_STARTTLS=False
MAIL_SSL_TLS=True

# ---------- 安全与 AI ----------
JWT_SECRET_KEY=请改成随机长字符串
api_key=请填写你的 DeepSeek API Key
